rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email; }

    // Org-admins: a hardcoded bootstrap list PLUS anyone in the /orgAdmins
    // collection (manageable in-app). FORKS: replace the emails below with your
    // own bootstrap org-admin(s) before publishing — rules can't read env, so
    // this list is the one place that must be edited by hand (keep it in sync
    // with VITE_ORG_ADMINS / ORG_ADMINS in src/cloud.js).
    function isOrgAdmin() {
      return signedIn() && (
        email() in [
          'claudio.englert@gmail.com',
          'claudio@qualitin.com',
          'gastaoenglert@gmail.com'
        ]
        || exists(/databases/$(database)/documents/orgAdmins/$(email()))
      );
    }

    function memberPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/members/$(email());
    }
    function isMember(eventId) {
      return signedIn() && exists(memberPath(eventId));
    }
    // Null-safe: only get() after exists() confirmed the member doc.
    function memberRole(eventId) {
      return isMember(eventId) ? get(memberPath(eventId)).data.role : null;
    }
    function isEventAdmin(eventId) { return memberRole(eventId) == 'admin'; }
    function canWriteReports(eventId) { return memberRole(eventId) in ['admin', 'official']; }

    function eventPath(eventId) { return /databases/$(database)/documents/events/$(eventId); }
    function isActive(eventId) {
      return exists(eventPath(eventId)) && get(eventPath(eventId)).data.status == 'active';
    }

    // Public "which event is on Fistball Live" pointer. Anyone reads (spectator
    // app, no login); an admin of the target event (or org-admin) writes it.
    match /public/{docId} {
      allow read: if true;
      allow create, update: if isOrgAdmin() || isEventAdmin(request.resource.data.eventId);
      allow delete: if isOrgAdmin() || isEventAdmin(resource.data.eventId);
    }

    // Global people directory (name + email), reused when authorizing members
    // across events. Any signed-in organizer can read/upsert.
    match /people/{personEmail} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Global org-admins directory (grant full access without a code change).
    // Any signed-in user can read (so the client knows if they're an org-admin);
    // only existing org-admins can add/remove.
    match /orgAdmins/{adminEmail} {
      allow read: if signedIn();
      allow write: if isOrgAdmin();
    }

    // Global logo library (name + small data-URL), reusable across events.
    match /logos/{logoId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /events/{eventId} {
      allow read: if isOrgAdmin() || isMember(eventId);
      allow create: if isOrgAdmin()
                    && request.resource.data.status in ['active', 'archived']
                    && request.resource.data.createdBy == request.auth.uid;
      // Event admins can edit AND re-activate/archive their own event; org-admins anything.
      allow update: if isOrgAdmin() || isEventAdmin(eventId);
      allow delete: if isOrgAdmin();

      match /members/{memberEmail} {
        // Read own membership: match the EMAIL FIELD (not the doc id) so the
        // collection-group query `where('email','==', myEmail)` in listMyEvents
        // is authorized — a doc-id condition can't be proven safe for that query.
        allow read: if isOrgAdmin() || isEventAdmin(eventId)
                    || (signedIn() && resource.data.email == email());
        allow write: if isOrgAdmin() || (isEventAdmin(eventId) && isActive(eventId));
      }

      match /games/{gameId} {
        allow read: if isOrgAdmin() || isMember(eventId);
        allow write: if isOrgAdmin() || (isEventAdmin(eventId) && isActive(eventId));
      }
      match /rosters/{rosterId} {
        allow read: if isOrgAdmin() || isMember(eventId);
        allow write: if isOrgAdmin() || (isEventAdmin(eventId) && isActive(eventId));
      }
      match /referees/{refId} {
        allow read: if isOrgAdmin() || isMember(eventId);
        allow write: if isOrgAdmin() || (isEventAdmin(eventId) && isActive(eventId));
      }
      match /meta/{docId} {
        allow read: if isOrgAdmin() || isMember(eventId);
        allow write: if isOrgAdmin() || (isEventAdmin(eventId) && isActive(eventId));
      }

      // Reports (súmulas): official OR admin OR org-admin, AND event active.
      // No report writes when archived — for anyone. Once SUBMITTED (or being
      // amended after submission) only an event admin / org-admin can change
      // it; only they can delete (reset) a report.
      match /reports/{gameId} {
        allow read: if isOrgAdmin() || isMember(eventId);
        allow create: if isActive(eventId) && (isOrgAdmin() || canWriteReports(eventId));
        allow update: if isActive(eventId) && (isOrgAdmin() || isEventAdmin(eventId)
          || (canWriteReports(eventId)
              && resource.data.get('status', '') != 'submitted'
              && resource.data.get('amending', false) != true));
        allow delete: if isActive(eventId) && (isOrgAdmin() || isEventAdmin(eventId));
      }

      // Results: PUBLIC read (spectator app, no login); official/admin write.
      match /results/{gameId} {
        allow read: if true;
        allow write: if isOrgAdmin() || (canWriteReports(eventId) && isActive(eventId));
      }
    }
  }
}
