# Local test environment — loaded by `vite --mode emulator` (see compose.yaml).
# Talks to the Firebase Emulator Suite; nothing reaches the real project.
# "demo-" project ids are offline-only by design in Firebase.
VITE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-fistball
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fistball.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-fistball.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
# Defaults to the host serving the app; set to pin a specific emulator host.
# VITE_EMULATOR_HOST=localhost
